# ~/.zshrc

# Prepend ~/.local/bin to PATH when it exists — standard XDG-ish location
# for user-installed CLIs (uv, pipx, plugin-managed binaries, etc.). Skip
# if already on PATH so re-sourcing this file is idempotent.
if [[ -d "$HOME/.local/bin" ]]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) export PATH="$HOME/.local/bin:$PATH" ;;
    esac
fi

# Lines configured by zsh-newuser-install
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000
unsetopt autocd beep extendedglob
# Each shell keeps its own history file; don't merge across sessions.
unsetopt share_history
bindkey -v
# End of lines configured by zsh-newuser-install

# Require Ctrl+D twice on an empty line to exit (zsh equivalent of bash's
# IGNOREEOF=1; mirrors the tmux.conf `set-environment -g IGNOREEOF 1`
# behavior so both shells agree).
setopt IGNORE_EOF
_ctrl_d_count=0
_ctrl_d_exit() {
    if [[ -n "$BUFFER" ]]; then
        zle delete-char-or-list
        _ctrl_d_count=0
        return
    fi
    _ctrl_d_count=$((_ctrl_d_count + 1))
    if (( _ctrl_d_count >= 2 )); then
        exit
    fi
    zle -M "Press Ctrl+D again to exit shell"
}
zle -N _ctrl_d_exit
bindkey '^D' _ctrl_d_exit
_reset_ctrl_d_count() { _ctrl_d_count=0; }
# Membership guards keep re-sourcing this file from duplicating hooks;
# other entries (vendor hooks) are left as they are.
(( ${precmd_functions[(Ie)_reset_ctrl_d_count]} )) \
    || precmd_functions+=(_reset_ctrl_d_count)

# The following lines were added by compinstall
zstyle :compinstall filename '/home/lap/.zshrc'

autoload -Uz compinit
compinit -i
# End of lines added by compinstall

# ----- Custom Prompt -----

# Colors
BLUE='%F{cyan}'
GREEN='%F{green}'
RED='%F{red}'
MAGENTA='%F{magenta}'
RESET='%f'

# Git branch on the first prompt line. Uses zsh's built-in vcs_info so
# there's no fork-per-prompt cost; empty when cwd is not a git repo.
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats " ${MAGENTA}(%b)${RESET}"
zstyle ':vcs_info:git:*' actionformats " ${MAGENTA}(%b|%a)${RESET}"
(( ${precmd_functions[(Ie)vcs_info]} )) || precmd_functions+=(vcs_info)
setopt PROMPT_SUBST

# Prompt pieces
USER_AND_HOST="${BLUE}%n${GREEN}@${BLUE}%m"
WORKDIR="${BLUE}:${GREEN}%~"

# Final prompt: insert a real newline before the symbol. vcs_info_msg_0_
# is re-evaluated on every prompt render thanks to PROMPT_SUBST.
PROMPT='${USER_AND_HOST}${WORKDIR}${vcs_info_msg_0_}${RESET}
${BLUE}%#${RESET} '

# ----- Environment and public helpers (parity with ~/.bashrc) -----

# LS_COLORS from the same database bash uses.
if (( $+commands[dircolors] )); then
    if [[ -f ~/.dir_colors ]]; then
        eval "$(dircolors -b ~/.dir_colors)"
    elif [[ -f /etc/DIR_COLORS ]]; then
        eval "$(dircolors -b /etc/DIR_COLORS)"
    fi
fi

export VBOX_USB=usbfs
export EDITOR='vim'
export VISUAL='vim'
# Create pipenv virtual environment inside project directory
export PIPENV_VENV_IN_PROJECT=1
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk/
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
# Suppress Python HTTP warnings when work with devenv
export PYTHONWARNINGS="ignore:Unverified HTTPS request"

# Shared helper variables and ~/bin/.env, as bin/helper.bash loads them.
[[ -r "${HOME}/bin/helper/common.bash" ]] && source "${HOME}/bin/helper/common.bash"
if [[ -f "${HOME}/bin/.env" ]]; then
    source "${HOME}/bin/.env"
elif [[ -f "${HOME}/bin/.env.template" ]]; then
    source "${HOME}/bin/.env.template"
fi

# Same managed PATH entries as bin/helper.bash, each added at most once.
[[ ":${PATH}:" == *":${HOME}/ai-wrapper/bin:"* ]] || export PATH="${HOME}/ai-wrapper/bin:${PATH}"
[[ ":${PATH}:" == *":${HOME}/bin:"* ]] || export PATH="${HOME}/bin:${PATH}"

# Shared aliases first: helper bodies parsed afterwards expand them, as
# in bash. Portable and stateful helper modules are sourced in-process
# (hh_gio_mount must change this shell's cwd); Bash-only helpers run
# through bash_exec.zsh. Order matters: zsh-specific *.zsh files go after
# any shared *.bash module that might define a same-named stub. Bash-only
# modules and completion callbacks are never sourced here.
for _mod in \
    "${HOME}/bin/helper/aliases.shrc" \
    "${HOME}/bin/helper/tmux_commands.bash" \
    "${HOME}/bin/helper/git.bash" \
    "${HOME}/bin/helper/storage.bash" \
    "${HOME}/bin/helper/tmux_last_cmd.zsh" \
    "${HOME}/bin/helper/bash_exec.zsh"; do
    [[ -r "${_mod}" ]] && source "${_mod}"
done
unset _mod

# Argument completion for the transfer helpers, mirroring
# ~/.bash_completion.d/transfer.bash with zsh's own _arguments/_files/
# _ssh_hosts (no extra completion functions). hh_cp_ssh is an alias and
# completes as hh_rsync_ssh.
if (( $+functions[compdef] && $+functions[hh_rsync_ssh] )); then
    compdef '_arguments -s "-h[show help]" "-n[dry run]" "-z[enable compression]" "-p+[SSH port]:port: " "-c+[SSH cipher]:cipher:(aes128-gcm@openssh.com chacha20-poly1305@openssh.com aes256-gcm@openssh.com aes128-ctr aes256-ctr aes192-ctr)" "*:source or destination:{_files; _ssh_hosts}"' hh_rsync_ssh
    compdef '_arguments -s "-h[show help]" "-n[dry run]" "-f[skip confirmation]" "-p+[SSH port]:port: " "1:remote host:_ssh_hosts" "*:remote path: "' hh_rm_ssh
fi

# Optional job setup exports, as bin/helper.bash sources them.
if [[ -e "${JOB_SETUP_FILE:-}" ]]; then
    source "${JOB_SETUP_FILE}"
fi

if [[ -d "${HOME}/.pyenv" ]]; then
    export PYENV_ROOT="${HOME}/.pyenv"
    [[ -d "${PYENV_ROOT}/bin" && ":${PATH}:" != *":${PYENV_ROOT}/bin:"* ]] \
        && export PATH="${PYENV_ROOT}/bin:$PATH"
    eval "$(pyenv init - zsh)"
fi

