# AI agent runtime directories - these are created and managed by the agents themselves
# and should not be tracked by chezmoi

# Claude Code directories (repo-local skills under .claude/skills/ are tracked)
/.claude/*
!/.claude/skills/
.claude.json

# Codex CLI directories
.codex

# Cursor Agent directories
.cursor
.config/cursor
.local/share/cursor-agent

/worktrees/

# Python bytecode caches
__pycache__/
*.pyc
