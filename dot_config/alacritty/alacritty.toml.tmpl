[font]
{{ if eq .chezmoi.hostname "dragonlady" -}}
size = 10.0
{{ else if eq .chezmoi.hostname "dragoncave" -}}
size = 11.0
{{ end -}}

[font.bold]
family = "terminus"
style = "Bold"

[font.bold_italic]
family = "terminus"
style = "Bold Italic"

[font.normal]
family = "terminus"
style = "Regular"

[selection]
# Do not push mouse-drag selections to the system CLIPBOARD. Selection
# still populates X11 PRIMARY (middle-click paste); use tmux's `y` /
# `Enter` bindings for explicit clipboard copy.
save_to_clipboard = false

[window]
opacity = 0.8
