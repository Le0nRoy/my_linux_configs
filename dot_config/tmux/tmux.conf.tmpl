{{- /* Clipboard command picked per-OS at chezmoi apply time. Copy bindings run
       under whatever $SHELL tmux spawns, so use plain executables — no shell
       functions, no PATH surprises. */ -}}
{{- $clipCopy  := "xclip -i -sel clipboard" -}}
{{- $clipPaste := "xclip -o -sel clipboard" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $clipCopy  = "pbcopy" -}}
{{-   $clipPaste = "pbpaste" -}}
{{- end }}
#### Shortcuts
bind C-c run "tmux save-buffer - | {{ $clipCopy }}"
bind C-v run "tmux set-buffer \"$({{ $clipPaste }})\"; tmux paste-buffer"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Use vi keys in copy mode
set -g mode-keys vi

# Enable mouse: scroll, select pane, drag-select to copy
set -g mouse on

# Forward OSC 52 clipboard writes from applications (Claude Code's
# in-TUI scroll+copy, nvim's "+y, etc.) to the outer terminal's system
# clipboard AND populate tmux's own paste buffer. `external` only did
# the forward and only when the outer client reported the `clipboard`
# feature AND was viewing the emitting pane — fragile. `on` keeps both
# paths filled so copy works even when the emitting pane isn't the
# attached client's current view.
set -g set-clipboard on
# Belt-and-braces: declare the clipboard capability for alacritty and
# tmux-256color terminfo entries. The xterm*:clipboard default already
# covers the common Alacritty-reporting-as-xterm-256color case, but a
# future TERM switch (or a nested tmux reporting tmux-256color to the
# outer tmux) would silently drop OSC 52 without these.
set -ag terminal-features ',alacritty*:clipboard'
set -ag terminal-features ',tmux*:clipboard'
{{- if eq .chezmoi.os "darwin" }}
# macOS Terminal.app has no OSC 52 handler and tmux 3.7c's after-set-buffer
# hook does NOT fire on the OSC 52 → paste_add path (confirmed by probe:
# the hook fires on `set-buffer` command only). Bridge via pipe-pane: a
# streaming Python filter extracts OSC 52 payloads from raw pane output
# and pbcopy's the decoded bytes. Covers Claude Code's scroll+copy,
# nvim `+y, and any OSC 52 writer.
# The after-set-buffer hook is kept as a secondary path for the
# `tmux set-buffer` command (manual, or future tmux versions that route
# OSC 52 through set-buffer).
set-hook -g after-set-buffer 'run-shell -b "tmux save-buffer - | pbcopy"'

# Install OSC 52 filter on every new pane. tmux hook actions run with
# the triggering pane as context, so pipe-pane without -t targets the
# right pane. `-o` is "only open if not already piped" — idempotent.
set-hook -g session-created 'pipe-pane -o "~/bin/tmux_osc52_pbcopy.py"'
set-hook -g after-new-window 'pipe-pane -o "~/bin/tmux_osc52_pbcopy.py"'
set-hook -g after-split-window 'pipe-pane -o "~/bin/tmux_osc52_pbcopy.py"'

# One-shot install for panes that already exist at config load (the
# hooks only fire for new panes). Backgrounded so a slow tmux round-trip
# never blocks source-file.
run-shell -b '~/bin/tmux_pipe_pane_init.bash'
{{- end }}

# Enter → copy and exit (default)
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "{{ $clipCopy }}"
# Ctrl+w → copy but stay
bind -T copy-mode-vi C-w send-keys -X copy-pipe "{{ $clipCopy }}"
# v → begin visual selection (vi-style)
bind -T copy-mode-vi v send-keys -X begin-selection
# y → yank, stay in copy mode, drop selection, park cursor at selection start
bind -T copy-mode-vi y send-keys -X copy-pipe-no-clear "{{ $clipCopy }}" \; send-keys -X other-end \; send-keys -X clear-selection
# Mouse drag → end selection without copying; selection stays visible. Press y/Enter to copy.
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-no-clear


# Disable layouts switching by 'C-b Space'
unbind-key Space

# Enable xterm shortcuts in visual mode
unbind C-Left
unbind C-Right
set-window-option -g xterm-keys on

# Resize mode. Enter with `C-b R`. The mode is a per-client key table
# entered via `switch-client -T resize` (not the session-wide
# `key-table` option, which would drag every client attached to the
# session into resize mode). A non-root table only lasts for one key,
# so each binding re-enters it. `Any` swallows keys with no binding —
# without it tmux falls back to the root table and types the key into
# the pane. h/j/k/l and arrows resize the active pane by 2 cells; the
# Shift-variants (H/J/K/L, S-Arrows) step 5 cells. `q` or Escape
# returns to the root table; the prefix key also works and leaves the
# mode. The status-left banner (below) shows `RESIZE MODE`.
bind R switch-client -T resize

# Fine step: 2 cells
bind -T resize h     resize-pane -L 2 \; switch-client -T resize
bind -T resize j     resize-pane -D 2 \; switch-client -T resize
bind -T resize k     resize-pane -U 2 \; switch-client -T resize
bind -T resize l     resize-pane -R 2 \; switch-client -T resize
bind -T resize Left  resize-pane -L 2 \; switch-client -T resize
bind -T resize Down  resize-pane -D 2 \; switch-client -T resize
bind -T resize Up    resize-pane -U 2 \; switch-client -T resize
bind -T resize Right resize-pane -R 2 \; switch-client -T resize
# Coarse step: 5 cells (Shift)
bind -T resize H       resize-pane -L 5 \; switch-client -T resize
bind -T resize J       resize-pane -D 5 \; switch-client -T resize
bind -T resize K       resize-pane -U 5 \; switch-client -T resize
bind -T resize L       resize-pane -R 5 \; switch-client -T resize
bind -T resize S-Left  resize-pane -L 5 \; switch-client -T resize
bind -T resize S-Down  resize-pane -D 5 \; switch-client -T resize
bind -T resize S-Up    resize-pane -U 5 \; switch-client -T resize
bind -T resize S-Right resize-pane -R 5 \; switch-client -T resize
bind -T resize q      switch-client -T root
bind -T resize Escape switch-client -T root
# Swallow every other key and stay in the mode.
bind -T resize Any    switch-client -T resize

# Show pane numbers
set -g display-panes-time 2000

# Exit from the bash by Ctrl+d x2
set-environment -g 'IGNOREEOF' 1
# alternative for other shell emulatores
#bind-key -n C-d detach

# Confirm before `:kill-session` — easy to type when you meant kill-window.
# The inner command must be `kill-ses` (unique prefix), not `kill-session`:
# confirm-before re-parses its command on 'y', which would re-expand this
# alias and just show the prompt again forever.
set -s command-alias[100] "kill-session=confirm-before -p 'kill-session #S? (y/n)' kill-ses"

#### STATUS BAR
# Update status bar every 2 seconds
set -g status-interval 2

# Status bar position
set -g status-position bottom

# Status bar left: current program name and window list
set -g status-left-length 120
set -g status-left "#{?#{==:#{client_key_table},resize},#[fg=black bg=red bold] RESIZE MODE: hjkl/arrows=slow  HJKL/S-arrows=fast  q/Escape=exit #[default] ,}#[fg=green,bold]#(ps -t #{pane_tty} -o comm= | tail -1) #[fg=yellow]| "

# Status bar right: git branch and date/time
set -g status-right-length 80
set -g status-right "#[fg=cyan]#(${HOME}/bin/tmux_git_branch.bash '#{pane_current_path}')#[fg=yellow] | #[fg=white]%d/%b/%Y %H:%M"

# Window status format with separator
set -g window-status-separator " #[fg=yellow]|#[fg=brightblue] "
set -g window-status-format "#I:#W"
set -g window-status-current-format "#I:#W"

#### COLOUR (Solarized dark)
# default statusbar colors
set-option -g status-style fg=yellow,bg=black #yellow and base02
# default window title colors
set-window-option -g window-status-style fg=brightblue,bg=default #base0 and default
set-window-option -g window-status-style dim
# active window title colors
set-window-option -g window-status-current-style fg=brightred,bg=default #orange and default

# pane border - improved visibility
set-option -g pane-border-style fg=colour235 #very dark gray for inactive panes
set-option -g pane-active-border-style fg=brightgreen,bold #bright green bold for active pane

# Dim inactive panes
set -g window-style 'fg=colour247,bg=colour236'
set -g window-active-style 'fg=colour250,bg=black'

# message text
set-option -g message-style fg=brightred,bg=black #orange and base01
# pane number display
set-option -g display-panes-active-colour brightred #orange
set-option -g display-panes-colour blue #blue
# clock
set-window-option -g clock-mode-colour green #green
# bell
set-window-option -g window-status-bell-style fg=black,bg=red #base02, red

#### Plugins (tpm) — session persistence
# Bootstrap: run_once_install-tpm-plugins.bash clones tpm and installs
# these on chezmoi apply. On macOS a LaunchAgent starts the tmux server
# at login so a Terminal.app cmd+Q or crash cannot take sessions with it.

# tpm reads this to locate the plugin dir. Setting it explicitly avoids
# tpm's `show-environment` fallback path (which prints
# "unknown variable: TMUX_PLUGIN_MANAGER_PATH" to stderr when unset).
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins/"

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Preserve visible pane contents (scrollback) alongside layouts/cwd.
set -g @resurrect-capture-pane-contents 'on'
# Extra programs restored inside panes. Tilde prefix = match anywhere in
# the command line, so `watch '...git status...'` and `journalctl -f`
# survive. claude_wrapper.bash is intentionally omitted: the pre-fill
# layer re-arms the last-typed command so the operator confirms with Enter.
set -g @resurrect-processes '"~watch" "~journalctl -f"'
{{- if eq .chezmoi.os "linux" }}
# Save each pane's command from /proc/<pid>/cmdline, shell-quoted per
# argv element (printf %q). The default `ps` strategy joins argv with
# spaces, so `watch 'a; b'` is saved as `watch a; b` and restore sends
# that to the shell, which runs only `watch a` (git_watch lost its
# second command). linux_procfs ships with tmux-resurrect; macOS has no
# /proc, so it keeps the default there.
set -g @resurrect-save-command-strategy 'linux_procfs'
{{- end }}
# Snapshot lives under runtime state, out of chezmoi source.
set -g @resurrect-dir '{{ env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local/state") }}/tmux/resurrect'
# Post-restore hook: pre-fill each pane with the shell's last-typed
# command from ~/.local/state/tmux/panes/<sess:win.pane>.last.
set -g @resurrect-hook-post-restore-all 'run-shell "${HOME}/bin/tmux_prefill_last_cmd.bash"'
# Release a pane's per-pane shell history file when its shell exits by
# itself, so a new pane taking that #S:#I.#P does not inherit it. tmux
# does not fire pane-exited on kill-server or a crash, so resurrect
# still finds the files. Fixed index [100] keeps a config reload from
# stacking duplicate hooks.
set-hook -g 'pane-exited[100]' 'run-shell -b "${HOME}/bin/tmux_pane_hist_release.bash #{hook_pane}"'

# Autosave every 5 minutes, auto-restore on server start.
set -g @continuum-save-interval '5'
set -g @continuum-restore 'on'
# @continuum-boot stays off — LaunchAgent owns startup on macOS.
set -g @continuum-boot 'off'

# tpm init — MUST remain the last line of this file.
run '~/.tmux/plugins/tpm/tpm'
