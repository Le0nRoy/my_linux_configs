{{- /* Clipboard command picked per-OS at chezmoi apply time. Copy bindings run
       under whatever $SHELL tmux spawns, so use plain executables — no shell
       functions, no PATH surprises. */ -}}
{{- $clipCopy  := "xclip -i -sel clipboard" -}}
{{- $clipPaste := "xclip -o -sel clipboard" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $clipCopy  = "pbcopy" -}}
{{-   $clipPaste = "pbpaste" -}}
{{- end }}
#### Shortcuts
bind C-c run "tmux save-buffer - | {{ $clipCopy }}"
bind C-v run "tmux set-buffer \"$({{ $clipPaste }})\"; tmux paste-buffer"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Use vi keys in copy mode
set -g mode-keys vi

# Enable mouse: scroll, select pane, drag-select to copy
set -g mouse on

# Enter → copy and exit (default)
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "{{ $clipCopy }}"
# Ctrl+w → copy but stay
bind -T copy-mode-vi C-w send-keys -X copy-pipe "{{ $clipCopy }}"
# v → begin visual selection (vi-style)
bind -T copy-mode-vi v send-keys -X begin-selection
# y → yank, stay in copy mode, drop selection, park cursor at selection start
bind -T copy-mode-vi y send-keys -X copy-pipe-no-clear "{{ $clipCopy }}" \; send-keys -X other-end \; send-keys -X clear-selection
# Mouse drag → end selection without copying; selection stays visible. Press y/Enter to copy.
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-no-clear


# Disable layouts switching by 'C-b Space'
unbind-key Space

# Enable xterm shortcuts in visual mode
unbind C-Left
unbind C-Right
set-window-option -g xterm-keys on

# Show pane numbers
set -g display-panes-time 2000

# Exit from the bash by Ctrl+d x2
set-environment -g 'IGNOREEOF' 1
# alternative for other shell emulatores
#bind-key -n C-d detach

#### STATUS BAR
# Update status bar every 2 seconds
set -g status-interval 2

# Status bar position
set -g status-position bottom

# Status bar left: current program name and window list
set -g status-left-length 40
set -g status-left "#[fg=green,bold]#(ps -t #{pane_tty} -o comm= | tail -1) #[fg=yellow]| "

# Status bar right: git branch and date/time
set -g status-right-length 80
set -g status-right "#[fg=cyan]#(${HOME}/bin/tmux_git_branch.bash '#{pane_current_path}')#[fg=yellow] | #[fg=white]%d/%b/%Y %H:%M"

# Window status format with separator
set -g window-status-separator " #[fg=yellow]|#[fg=brightblue] "
set -g window-status-format "#I:#W"
set -g window-status-current-format "#I:#W"

#### COLOUR (Solarized dark)
# default statusbar colors
set-option -g status-style fg=yellow,bg=black #yellow and base02
# default window title colors
set-window-option -g window-status-style fg=brightblue,bg=default #base0 and default
set-window-option -g window-status-style dim
# active window title colors
set-window-option -g window-status-current-style fg=brightred,bg=default #orange and default

# pane border - improved visibility
set-option -g pane-border-style fg=colour235 #very dark gray for inactive panes
set-option -g pane-active-border-style fg=brightgreen,bold #bright green bold for active pane

# Dim inactive panes
set -g window-style 'fg=colour247,bg=colour236'
set -g window-active-style 'fg=colour250,bg=black'

# message text
set-option -g message-style fg=brightred,bg=black #orange and base01
# pane number display
set-option -g display-panes-active-colour brightred #orange
set-option -g display-panes-colour blue #blue
# clock
set-window-option -g clock-mode-colour green #green
# bell
set-window-option -g window-status-bell-style fg=black,bg=red #base02, red

#### Plugins (tpm) — session persistence
# Bootstrap: run_once_install-tpm-plugins.bash clones tpm and installs
# these on chezmoi apply. On macOS a LaunchAgent starts the tmux server
# at login so a Terminal.app cmd+Q or crash cannot take sessions with it.

# tpm reads this to locate the plugin dir. Setting it explicitly avoids
# tpm's `show-environment` fallback path (which prints
# "unknown variable: TMUX_PLUGIN_MANAGER_PATH" to stderr when unset).
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins/"

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Preserve visible pane contents (scrollback) alongside layouts/cwd.
set -g @resurrect-capture-pane-contents 'on'
# Extra programs restored inside panes. Tilde prefix = match anywhere in
# the command line, so `watch '...git status...'` and `journalctl -f`
# survive. claude_wrapper.bash is intentionally omitted: the pre-fill
# layer re-arms the last-typed command so the operator confirms with Enter.
set -g @resurrect-processes '"~watch" "~journalctl -f"'
# Snapshot lives under runtime state, out of chezmoi source.
set -g @resurrect-dir '{{ env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local/state") }}/tmux/resurrect'
# Post-restore hook: pre-fill each pane with the shell's last-typed
# command from ~/.local/state/tmux/panes/<sess:win.pane>.last.
set -g @resurrect-hook-post-restore-all 'run-shell "${HOME}/bin/tmux_prefill_last_cmd.bash"'

# Autosave every 5 minutes, auto-restore on server start.
set -g @continuum-save-interval '5'
set -g @continuum-restore 'on'
# @continuum-boot stays off — LaunchAgent owns startup on macOS.
set -g @continuum-boot 'off'

# tpm init — MUST remain the last line of this file.
run '~/.tmux/plugins/tpm/tpm'
