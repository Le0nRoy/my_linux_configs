#set -x
#
# ~/.bashrc
#

[[ $- != *i* ]] && return

[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
if [[ -d /etc/bash_completion.d  ]]; then
	for i in `ls /etc/bash_completion.d`
	do
		. /etc/bash_completion.d/$i
	done
fi
if [[ -d ~/.bash_completion.d ]]; then
	for f in ~/.bash_completion.d/*; do
		. "$f"
	done
fi

# macOS: brew drops completions in /opt/homebrew/etc/bash_completion.d but
# no loader is registered without the bash-completion formula.
if [[ -d /opt/homebrew/etc/bash_completion.d ]]; then
	for f in /opt/homebrew/etc/bash_completion.d/*; do
		[ -r "$f" ] && . "$f"
	done
fi
# Apple git ships its own completion outside brew paths
[ -r /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash ] \
	&& . /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash

# Change the window title of X terminals
case ${TERM} in
	xterm*|rxvt*|Eterm*|aterm|kterm|gnome*|interix|konsole*)
		PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME%%.*}:${PWD/#$HOME/\~}\007"'
		;;
	screen*)
		PROMPT_COMMAND='echo -ne "\033_${USER}@${HOSTNAME%%.*}:${PWD/#$HOME/\~}\033\\"'
		;;
esac

use_color=true

# ` (branch)` fragment for the first PS1 line. Uses `git symbolic-ref`
# for the common case and falls back to a short SHA for detached HEAD.
# Silent (empty) when cwd is not a git working tree. No external tooling
# beyond git itself.
_bashrc_git_branch() {
    local ref
    if ref=$(git symbolic-ref --short HEAD 2>/dev/null); then
        :
    elif ref=$(git rev-parse --short HEAD 2>/dev/null); then
        :
    else
        return
    fi
    printf ' (%s)' "${ref}"
}

# Set colorful PS1 only on colorful terminals.
# dircolors --print-database uses its own built-in database
# instead of using /etc/DIR_COLORS.  Try to use the external file
# first to take advantage of user additions.  Use internal bash
# globbing instead of external grep binary.
safe_term=${TERM//[^[:alnum:]]/?}   # sanitize TERM
match_lhs=""
[[ -f ~/.dir_colors   ]] && match_lhs="${match_lhs}$(<~/.dir_colors)"
[[ -f /etc/DIR_COLORS ]] && match_lhs="${match_lhs}$(</etc/DIR_COLORS)"
[[ -z ${match_lhs}    ]] \
	&& type -P dircolors >/dev/null \
	&& match_lhs=$(dircolors --print-database)
[[ $'\n'${match_lhs} == *$'\n'"TERM "${safe_term}* ]] && use_color=true


if ${use_color} ; then
	# Enable colors for ls, etc.  Prefer ~/.dir_colors #64489
	if type -P dircolors >/dev/null ; then
		if [[ -f ~/.dir_colors ]] ; then
			eval $(dircolors -b ~/.dir_colors)
		elif [[ -f /etc/DIR_COLORS ]] ; then
			eval $(dircolors -b /etc/DIR_COLORS)
		fi
	fi

	if [[ ${EUID} == 0 ]] ; then
		PS1='\[\033[01;31m\][\h\[\033[01;36m\] \W\[\033[01;31m\]]\$\[\033[00m\] '
	else
		BLUE_COLOR='\[\033[02;36m\]'
		RED_COLOR='\[\033[02;31m\]'
		GREEN_COLOR='\[\033[32m\]'
		MAGENTA_COLOR='\[\033[35m\]'
                WHITE_COLOR='\[\033[00m\]'

                USER_AND_HOST="${BLUE_COLOR}\u${GREEN_COLOR}@${BLUE_COLOR}\h"
                WORKDIR="${BLUE_COLOR}:${GREEN_COLOR}\w"
                # Git branch on the same first line as user@host:cwd.
                # Empty when not inside a repo. Single-quoted so bash
                # re-runs the substitution on every prompt render.
                GIT_BRANCH="${MAGENTA_COLOR}"'$(_bashrc_git_branch)'"${WHITE_COLOR}"
                WORKSPACE="${BLUE_COLOR}\n\$${WHITE_COLOR} "

		PS1="${USER_AND_HOST}${WORKDIR}${GIT_BRANCH}${WORKSPACE}"
	fi
else
	if [[ ${EUID} == 0 ]] ; then
		# show root@ when we don't have colors
		PS1='\u@\h \W \$ '
	else
		PS1='\u@\h \w \$ '
	fi
fi

unset use_color safe_term match_lhs sh

# Aliases shared with zsh (and with the Bash child zsh runs helpers in).
# Sourced before helper.bash so helper bodies keep expanding them.
[[ -r "${HOME}/bin/helper/aliases.shrc" ]] && source "${HOME}/bin/helper/aliases.shrc"

xhost +local:root > /dev/null 2>&1

complete -cf sudo

# Bash won't get SIGWINCH if another process is in the foreground.
# Enable checkwinsize so that bash will check the terminal size when
# it regains control.  #65623
# http://cnswww.cns.cwru.edu/~chet/bash/FAQ (E11)
shopt -s checkwinsize

shopt -s expand_aliases

# export QT_SELECT=4

# Enable history appending instead of overwriting.  #139609
shopt -s histappend

export VBOX_USB=usbfs
export EDITOR='vim'
export VISUAL='vim'
# Create pipenv virtual environment inside project directory
export PIPENV_VENV_IN_PROJECT=1
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk/
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
# Suppress Python HTTP warnings when work with devenv
export PYTHONWARNINGS="ignore:Unverified HTTPS request"

HELPERS="$HOME/bin/helper.bash"
if [[ -e "${HELPERS}" ]]; then
    source ${HELPERS}
fi

if [[ -d "${HOME}/.pyenv" ]]; then
    export PYENV_ROOT="${HOME}/.pyenv"
    [[ -d "${PYENV_ROOT}/bin" && ":${PATH}:" != *":${PYENV_ROOT}/bin:"* ]] \
        && export PATH="${PYENV_ROOT}/bin:$PATH"
    eval "$(pyenv init - bash)"
fi
