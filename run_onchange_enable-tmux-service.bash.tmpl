#!/bin/bash
# Reload systemd user units when tmux.service changes; enable + start on
# first apply. Skip restart when already running so a live tmux server
# (with attached sessions) is not killed. Rendered unit hash below
# triggers chezmoi's run_onchange_ contract: chezmoi re-runs this script
# every time the hash changes.
#
# OS gating happens in .chezmoiignore — this script is skipped entirely
# on non-Linux hosts, matching how run_onchange_load-tmux-launchagent is
# gated to darwin-only there.
#
# Rendered unit hash: {{ include "dot_config/systemd/user/tmux.service" | sha256sum }}
set -euo pipefail

mkdir -p "${HOME}/.local/state/tmux"

systemctl --user daemon-reload

if ! systemctl --user is-active tmux.service >/dev/null 2>&1; then
    systemctl --user enable --now tmux.service
else
    echo "tmux.service already active — unit changes take effect on next restart"
    echo "  systemctl --user restart tmux.service   # WARNING: kills running tmux server"
fi
